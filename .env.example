# Local PostgreSQL connection. Copy this file to .env and enter your password.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=pharma_plus
PGUSER=postgres
PGPASSWORD=

# Creates a local admin account on API startup. Do not expose these values publicly.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Pharma Plus Admin

# Prescription uploads are encrypted outside the public web root.
# Generate a persistent key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PRESCRIPTION_STORAGE_KEY=
PRESCRIPTION_STORAGE_DIR=
CLAMSCAN_PATH=clamscan
