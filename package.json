{
  "name": "pharma-plus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "api:mobile": "node --env-file-if-exists=.env server/mobile-api.mjs",
    "db:setup": "node --env-file-if-exists=.env server/migrate.mjs",
    "mobile:cert": "node --env-file-if-exists=.env server/mobile-cert.mjs",
    "mobile:build": "node --env-file-if-exists=.env server/mobile-build.mjs",
    "build": "tsc -b && vite build",
