    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
